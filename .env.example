# Ayureze Doctor App - configuration template
#
Two ways to supply these, depending on what you are doing:
#
  Developer machine:
    cp .env.json.example .env.json
    flutter run --dart-define-from-file=.env.json
#
  CI / release:
    flutter build apk --release \
      --dart-define=SUPABASE_URL=... \
      --dart-define=SUPABASE_ANON_KEY=... \
      --dart-define=FIREBASE_API_KEY=...
#
A plain `.env` also works for `flutter run` in debug mode (flutter_dotenv
reads it directly), but it is NOT bundled into release builds: adding it to
pubspec assets would ship the file inside every APK. Use
--dart-define-from-file for local work so what you test is what ships.
#
See lib/core/config/env.dart for how these resolve and why.

# ---- Required ----------------------------------------------------------
# Public by design. They ship to clients in every Firebase/Supabase app.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Already committed in lib/firebase_options.dart; set here only to override.
FIREBASE_API_KEY=your_firebase_api_key

# ---- Optional / server authority --------------------------------------
# Push notifications and voice are disabled when these are unset, but the app
# still starts and works.
#
# SECURITY: these grant server-side authority, and are embedded in the binary
# when passed via --dart-define, so they are recoverable from a release APK.
# FIREBASE_SERVER_KEY in particular can push to every device in the project.
# Do not ship them in a client build. Move the calls that need them to the
# backend and inject the key there instead.

FIREBASE_SERVER_KEY=your_firebase_server_key
ASTRA_API_KEY=your_astra_api_key
SARVAM_API_KEY=your_sarvam_api_key

# ---- Local tooling only ------------------------------------------------
# Used by one-off upload scripts, not by the app at runtime.

WASABI_ACCESS_KEY=your_wasabi_access_key
WASABI_SECRET_KEY=your_wasabi_secret_key
WASABI_REGION=ap-southeast-1
WASABI_BUCKET=astraehr
WASABI_ENDPOINT=s3.ap-southeast-1.wasabisys.com
