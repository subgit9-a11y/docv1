# Build artifacts
/build/

# Generated plugin registrants. These are rewritten by `flutter pub get` and
# `flutter build`, so tracking them produces spurious diffs on every run and
# they are regenerated on demand. Already ignored for iOS above.
windows/flutter/generated_plugin_registrant.cc
windows/flutter/generated_plugin_registrant.h
windows/flutter/generated_plugins.cmake

# Dart
.dart_tool/

# Local scripts with secrets
supabase_to_mysql_sync.py
test_supabase.py

# One-off local refactor / inspection scripts. These were committed by mistake;
# they are not part of the app and several embed credentials or DB dumps.
/scratch/
/*.py

# Environment variables (secrets)
# Match every .env variant (.env.staging, .env.production, ...). A bare `.env`
# rule does not match those, which is how .env.staging got committed.
.env*
!.env.example
!.env.json.example

# Values for --dart-define-from-file live here. Local secret store; the same
# rule as .env applies, it must never be committed.
.env.json
*.env.json
