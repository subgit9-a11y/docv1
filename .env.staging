# AyurEze Doctor App - Staging Environment

# API Configuration
API_BASE_URL=https://staging-api.ayureze.in/api/v1
ASTRA_API_URL=https://staging-astra.ayureze.in/api/v1

# Cashfree Sandbox
CASHFREE_APP_ID=TEST_APP_ID_STAGING
CASHFREE_SECRET_KEY=TEST_SECRET_KEY_STAGING
CASHFREE_ENVIRONMENT=SANDBOX

# Agora Test Project
AGORA_APP_ID=TEST_AGORA_APP_ID
